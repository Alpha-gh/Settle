# Optional: API origin (e.g. http://localhost:3000). Leave empty for same-origin / Vite proxy.
VITE_API_BASE=

# Set to 'true' to run in standalone browser mock mode using MSW.
VITE_USE_MOCKS=false

# Latency in ms for MSW mock responses (only applies when VITE_USE_MOCKS=true).
VITE_MOCK_LATENCY_MS=250
