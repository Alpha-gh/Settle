{
  "name": "settle",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "typecheck": "tsc --build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "seed": "pnpm --filter @settle/api seed",
    "spike": "pnpm --filter @settle/api spike"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
