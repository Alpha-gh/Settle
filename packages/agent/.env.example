# LLM Provider Configuration
LLM_PROVIDER=mock # Options: mock, gemini, anthropic, openai
LLM_TIMEOUT_MS=15000

# Google Gemini (confirm current model IDs in official Gemini docs)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Anthropic Claude (confirm current model IDs in official Anthropic docs)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenAI (confirm current model IDs in official OpenAI docs)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
