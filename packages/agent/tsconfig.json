{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "noUncheckedIndexedAccess": true,
    "composite": true,
    "paths": {
      "@settle/shared": ["../shared/src/index.ts"]
