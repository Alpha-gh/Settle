# Date anchor for demo seed data (YYYY-MM-DD)
DEMO_TODAY=2026-11-05

# Database (support sslmode=require for Render or external hosted Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/settle
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/settle_test

# Engine and Agent Implementation (stub | real)
ENGINE_IMPL=real
AGENT_IMPL=real

# Web origin for CORS
WEB_ORIGIN=http://localhost:5173

# Webhook verification (set false to skip verification in test/dev)
WEBHOOK_VERIFY=true

# PayPal Invoicing Sandbox Credentials
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
PAYPAL_BUYER_EMAIL=
PAYPAL_BUYER_PASSWORD=

# Demo Provisioning Options
DEMO_BUYER_INVOICE_IDS=
AUTO_PROVISION_PAYPAL=false
# Optional suffix for PayPal invoice number (default: true).
# Set to false to omit random suffix for clean recording on a fresh sandbox.
PAYPAL_NUMBER_SUFFIX=true

# LLM configuration for agent implementation (mock | gemini | anthropic | openai)
LLM_PROVIDER=gemini
LLM_MODEL=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AGENT_FALLBACK_TO_STUB=true
